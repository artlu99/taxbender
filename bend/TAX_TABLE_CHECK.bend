# Generated by scripts/extract_tax_table.py from: i1040tt.pdf
# 2062 published Tax Table rows (TI 0–100,000); every row is
# checked at BOTH endpoints (value + flatness) for each status with
# a tables module. This is the paper table itself, as data.
# Checks are chunked into blocks — a single 8k-deep IO do-chain
# overflows the runtime's stack.
# ============================================================================

def ck_b(name: String, +got: Nat, +want: Nat, +ok: Bool) -> IO(Unit):
  match ok:
    case True{}:
      IO.print("PASS " ++ name ++ "\n")
    case False{}:
      IO.print("FAIL " ++ name ++ ": got " ++ Nat.show(got) ++ ", want " ++ Nat.show(want) ++ "\n")

def ck(+name: String, +got: Nat, +want: Nat) -> IO(Unit):
  ck_b(name, got, want, Nat.is_eq(got, want))

