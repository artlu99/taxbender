import Base
import ../bend/tax.bend as T
import ../inputs/inputs.bend as I

# ============================================================================
# return.bend — prints the finished return. Journalistic order: the
# headline (what you pay or get back) first, then the story of how it
# was computed, in the order a reader would want it — income, then the
# self-employment side, then deductions, then the tax itself.
#
# This file has no numbers of its own: the taxpayer's facts come from
# inputs.bend (generated by prepare.sh), the law from the chosen
# tables_2024_<status>.bend. Run: bend return.bend
# ============================================================================

def line(label: String, amount: Nat) -> String:
  label ++ Nat.show(amount) ++ "\n"

def bottom_line_b(+le: Bool, +tax: Nat, +pd: Nat) -> String:
  match le:
    case True{}:
      line("REFUND DUE TO YOU:    $", Nat.sub(pd, tax))
    case False{}:
      line("AMOUNT YOU OWE:       $", Nat.sub(tax, pd))

def bottom_line(+tax: Nat, +pd: Nat) -> String:
  bottom_line_b(Nat.is_le(tax, pd), tax, pd)

def fingerprint_line(fp: String) -> String:
  "facts fingerprint: sha256:" ++ fp ++ "\n"

def main() -> IO(Unit):
  do IO<Unit>:
    +f : T.Filing = I.filing()
    +tb : T.Tables = I.tables()

    +tax : Nat = T.tax(f, tb)
    +pd : Nat = T.paid(f)

    # ---- the headline --------------------------------------------------------
    IO.print("========================================\n")
    IO.print("          YOUR 2024 FORM 1040\n")
    IO.print("========================================\n")
    IO.print(fingerprint_line(I.facts_fingerprint()))
    IO.print(line("TOTAL TAX:            $", tax))
    IO.print(line("Payments made:        $", pd))
    IO.print(bottom_line(tax, pd))
    IO.print("\n")
    IO.print("----------------------------------------\n")
    IO.print(" How we got there\n")
    IO.print("----------------------------------------\n\n")

    # ---- the story, part 1: money coming in ----------------------------------
    IO.print("THE MONEY YOU MADE\n")
    IO.print(line("  Wages (W-2 box 1):          $", T.wages_of(f)))
    IO.print(line("  Taxable interest:           $", T.interest_of(f)))
    IO.print(line("  Short-term capital gains:   $", T.stcg_of(f)))
    IO.print(line("  Long-term capital gains:    $", T.net_cap_gain(f)))
    IO.print(line("  Business 1 net profit:      $", T.biz1_of(f)))
    IO.print(line("  Business 2 net profit:      $", T.biz2_of(f)))
    IO.print(line("  Total income:               $", T.total_income(f)))
    IO.print("\n")

    # ---- part 2: the self-employment side ------------------------------------
    +se : Nat = T.se_earnings(T.biz1_of(f), T.biz2_of(f))
    IO.print("YOUR TWO BUSINESSES (Schedule SE)\n")
    IO.print(line("  Net earnings, both pooled:  $", se))
    IO.print(line("  SE base (92.35%):           $", T.se_base(se)))
    IO.print(line("  Social Security wages (b3): $", T.ss_wages_of(f)))
    IO.print(line("  Social Security part:       $", T.ss_part(T.ss_wages_of(f), se, tb)))
    IO.print(line("  Medicare part:              $", T.med_part(se)))
    IO.print(line("  SE tax (added to your bill):$", T.se_tax(T.ss_wages_of(f), se, tb)))
    IO.print(line("  Deduction for half of it:   $", T.se_deduction(T.ss_wages_of(f), se, tb)))
    IO.print("\n")

    # ---- part 3: what you get to deduct --------------------------------------
    +ti : Nat = T.taxable_income(f, tb)
    +oti : Nat = T.ordinary_ti(f, tb)
    +ncg : Nat = T.net_cap_gain(f)
    IO.print("YOUR DEDUCTIONS\n")
    IO.print(line("  Half of SE tax:             $", T.se_deduction(T.ss_wages_of(f), se, tb)))
    IO.print(line("  Standard deduction:         $", T.std_ded(tb)))
    IO.print(line("  QBI deduction (20% cap):    $", T.qbi_ded(se, T.taxable_income_pre(f, tb), ncg)))
    IO.print("\n")

    # ---- part 4: the tax itself ----------------------------------------------
    IO.print("HOW THE TAX WAS COMPUTED\n")
    IO.print(line("  AGI:                        $", T.agi(f, tb)))
    IO.print(line("  Taxable income:             $", ti))
    IO.print(line("  Ordinary taxable income:    $", oti))
    IO.print("  (ordinary income is stacked under the gains, per Schedule D)\n")
    IO.print(line("  Tax on ordinary income:     $", T.ordinary_tax(oti, tb)))
    IO.print(line("  Tax on long-term gains:     $", T.ltcg_tax(oti, ncg, tb)))
    IO.print(line("  Self-employment tax:        $", T.se_tax(T.ss_wages_of(f), se, tb)))
    IO.print(line("  TOTAL TAX:                  $", tax))
    # runtime instantiation of the proven bands_tile6 law, on this return's table
    t1 : Bool = T.tiling_check(3000n, tb)
    t2 : Bool = T.tiling_check(30000n, tb)
    t3 : Bool = T.tiling_check(700000n, tb)
    IO.print("tiling re-check at $3k / $30k / $700k: ")
    IO.print(Bool.show(Bool.and(t1, Bool.and(t2, t3))))
    IO.print("\n")
